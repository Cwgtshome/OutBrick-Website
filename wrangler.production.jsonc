{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outbrick",
  "account_id": "e33a32f168de9597cfccf1698cb153a8",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "CONTEXT": "production",
    "SITE_ID": "8b73b763-21f4-405b-a284-a4605cc31d2f",
    "JOBS_ENABLED": "true",
    "CLOUDFLARE_TRANSLATION_ENABLED": "true",
    "RELEASE_EMAIL_AUTOSEND": "on",
    "RELEASE_EMAIL_DELAY_HOURS": "24",
    "COMMUNITY_REPLY_DOMAIN": "reply.outbrick.site"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "outbrick-uploads"
    },
    {
      "binding": "SIGNALS",
      "bucket_name": "outbrick-signals"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRANSLATION_BUDGET",
        "class_name": "TranslationBudget",
        "script_name": "outbrick-translation-budget"
      }
    ]
  },
  "routes": [
    {
      "pattern": "www.outbrick.site",
      "custom_domain": true
    },
    {
      "pattern": "outbrick.site",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
