{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/prebuild.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-qr.mjs && vinext build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/postbuild.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "audit:seo": "node scripts/audit-seo.mjs",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "smoke:browsers": "node scripts/smoke-browsers.mjs",
    "import:captures": "node scripts/import-captures.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "gsc": "node scripts/search-console.mjs",
    "bing": "node scripts/bing-webmaster.mjs",
    "verify:refs": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-references.mjs",
    "check:links": "node scripts/check-links.mjs",
    "covers": "python3 scripts/make-cover.py"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "shadcn": "4.18.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
