# Apple's CDN only accepts the association file when it is served as JSON, and the file has no
# extension for the host to infer that from.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# app-ads.txt must be served as plain text for the crawler to parse it; a host that guesses
# text/html from the extension is the usual reason verification silently fails.
/app-ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Security headers for every response. No Cache-Control here on purpose: Netlify concatenates
# a header set by more than one matching rule, and HTML should keep Netlify's default
# (max-age=0, must-revalidate) so a deploy is visible at once.
#
# CSP: every page carries inline scripts (the RSC payload `self.__next_f.push(...)`, the
# JSON-LD blocks) that change with each build, so script-src needs 'unsafe-inline'. The only
# third-party origin the site loads from is Google Fonts. The policy still shuts off plugins,
# <base> hijacking, foreign form posts, framing and every other third-party fetch. It was
# checked against the built site in headless Chromium with no violations reported.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; media-src 'self'; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# Content-hashed build output (vinext emits it under /_next/static): a changed file gets a new
# name, so the old one can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts, if any are added: names are stable per face and the files never change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Artwork and screenshots keep stable names, so they are not immutable: a day fresh, then
# served stale for up to a week while the CDN revalidates in the background.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/blog/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Feeds and the sitemap change with each deploy that adds a page; an hour is plenty.
/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
