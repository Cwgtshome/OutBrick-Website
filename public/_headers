# Apple's CDN only accepts the association file when it is served as JSON, and the file has no
# extension for the host to infer that from.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# app-ads.txt must be served as plain text for the crawler to parse it; a host that guesses
# text/html from the extension is the usual reason verification silently fails.
/app-ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Security headers for every response. No Cache-Control here on purpose: Netlify concatenates
# a header set by more than one matching rule, and HTML should keep Netlify's default
# (max-age=0, must-revalidate) so a deploy is visible at once.
#
# CSP: every page carries inline scripts (the RSC payload `self.__next_f.push(...)`, the
# JSON-LD blocks) that change with each build, so script-src needs 'unsafe-inline'. The only
# third-party origin the site loads from is Google Fonts. The policy still shuts off plugins,
# <base> hijacking, foreign form posts, framing and every other third-party fetch. It was
# checked against the built site in headless Chromium with no violations reported.
#
# Google Analytics (lib/analytics.ts) needs googletagmanager.com for gtag.js and Google's
# collection endpoints for its requests. Those origins are here only for builds with
# GA_MEASUREMENT_ID set: scripts/postbuild.mjs removes every one of them from dist/client/_headers
# when the build rendered no analytics code. Even when allowed, nothing is fetched from Google
# until a visitor accepts analytics in the consent banner.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; media-src 'self'; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# Content-hashed build output (vinext emits it under /_next/static): a changed file gets a new
# name, so the old one can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts, if any are added: names are stable per face and the files never change.
# The OutBrick emails (emails/core.ts) load Fredoka and Figtree from here, and a web font from
# another origin only loads with CORS, so these two OFL font files are open to any origin.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Artwork and screenshots keep stable names, so they are not immutable: a day fresh, then
# served stale for up to a week while the CDN revalidates in the background.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/blog/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Feeds and the sitemap change with each deploy that adds a page; an hour is plenty.
/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# The sitemap index's children: sitemap-pages-<locale>.xml and sitemap-journal-<locale>.xml.
/sitemap-*
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/humans.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# RFC 9116. Written by scripts/postbuild.mjs with an Expires one year after the build.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# Web app manifest: the CSP above allows it through manifest-src 'self'.
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# Email template previews exist only on Deploy Previews and branch deploys
# (scripts/build-email-previews.mjs); never indexed, wherever they appear.
/email-previews/*
  X-Robots-Tag: noindex, nofollow

/email-previews/*.txt
  Content-Type: text/plain; charset=utf-8
