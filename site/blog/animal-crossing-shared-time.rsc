n",null,{"children":"Sra, M., & Schmandt, C. (2015). Expanding social mobile games beyond the device screen. MIT Media Lab."}]," ",["$","a",null,{"href":"https://www.media.mit.edu/publications/expanding-social-mobile-games-beyond-the-device-screen/","target":"_blank","rel":"noreferrer","children":["Read source ",["$","$Lf",null,{"ref":"$undefined","iconNode":"$17:props:children:0:props:children:0:props:iconNode","className":"lucide-external-link","size":13}]]}]]}],["$","li","gaming-fit-2025",{"id":"reference-gaming-fit-2025","children":[["$","span",null,{"children":"Ballou, N., Vuorre, M., Hakman, T., Magnusson, K., & Przybylski, A. K. (2025). Perceived value of video games, but not hours played, predicts mental well-being in casual adult Nintendo players. Royal Society Open Science, 12(3)."}]," ",["$","a",null,{"href":"https://doi.org/10.1098/rsos.241174","target":"_blank","rel":"noreferrer","children":["Read source ",["$","$Lf",null,{"ref":"$undefined","iconNode":"$17:props:children:0:props:children:0:props:iconNode","className":"lucide-external-link","size":13}]]}]]}]]}]]}]
