ion-2017","children":[["$","span",null,{"children":"Rupp, M. A., Sweetman, R., Sosa, A. E., Smither, J. A., & McConnell, D. S. (2017). Searching for affective and cognitive restoration: Examining the restorative effects of casual video game play. Human Factors, 59(7), 1096–1107."}]," ",["$","a",null,{"href":"https://doi.org/10.1177/0018720817715360","target":"_blank","rel":"noreferrer","children":["Read source ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1d:props:children:0:props:children:0:props:iconNode","className":"lucide-external-link","size":13}]]}]]}],["$","li","time-wellbeing-2022",{"id":"reference-time-wellbeing-2022","children":[["$","span",null,{"children":"Vuorre, M., Johannes, N., Magnusson, K., & Przybylski, A. K. (2022). Time spent playing video games is unlikely to impact well-being. Royal Society Open Science, 9(7), 220411."}]," ",["$","a",null,{"href":"https://doi.org/10.1098/rsos.220411","target":"_blank","rel":"noreferrer","children":["Read source ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1d:props:children:0:props:children:0:props:iconNode","className":"lucide-external-link","size":13}]]}]]}],["$","li","gaming-fit-2025",{"id":"reference-gaming-fit-2025","children":[["$","span",null,{"children":"Ballou, N., Vuorre, M., Hakman, T., Magnusson, K., & Przybylski, A. K. (2025). Perceived value of video games, but not hours played, predicts mental well-being in casual adult Nintendo players. Royal Society Open Science, 12(3)."}]," ",["$","a",null,{"href":"https://doi.org/10.1098/rsos.241174","target":"_blank","rel":"noreferrer","children":["Read source ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1d:props:children:0:props:children:0:props:iconNode","className":"lucide-external-link","size":13}]]}]]}]]}]]}]
