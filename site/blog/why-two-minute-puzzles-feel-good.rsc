dgets"}],["$","a",null,{"href":"/about","children":"About OutBrick"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"footer-label","children":"Read about"}],["$","a",null,{"href":"/blog#category-player-habits","children":"Player habits"}],["$","a",null,{"href":"/blog#category-success-stories","children":"Success stories"}],["$","a",null,{"href":"/blog#category-game-craft","children":"Game craft"}],["$","a",null,{"href":"/blog#category-inclusive-design","children":"Inclusive design"}],["$","a",null,{"href":"/research","children":"Research method"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"footer-label","children":"Contact"}],["$","a",null,{"href":"/support","children":"Support"}],["$","a",null,{"href":"/contact","children":["Contact OutBrick ",["$","$L10",null,{"ref":"$undefined","iconNode":"$12:props:children:0:props:children:1:props:children:4:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"href":"/accessibility","children":["Accessibility ",["$","$L10",null,{"ref":"$undefined","iconNode":"$12:props:children:0:props:children:1:props:children:4:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}]]}],["$","div",null,{"className":"footer-bottom","children":[["$","span",null,{"children":"© 2026 OutBrick"}],["$","span",null,{"children":"Research is cited. Claims stay modest."}],["$","span",null,{"children":"Made with bricks and patience."}]]}]]}]
1f:T54e,{"@context":"https://schema.org","@type":"BlogPosting","@id":"https://www.outbrick.site/blog/why-two-minute-puzzles-feel-good/#article","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.outbrick.site/blog/why-two-minute-puzzles-feel-good"},"headline":"Why a two-minute puzzle can feel like a proper reset","description":"A research-backed look at competence, attention, and the small satisfactions that make a short OutBrick session worth returning to.","image":["https://www.outbrick.site/blog/why-two-minute-puzzles-feel-good.png"],"datePublished":"2026-09-04","dateModified":"2026-09-04","author":{"@type":"Person","name":"OutBrick Editorial Desk","description":"The OutBrick Editorial Desk turns player research, accessibility practice, and game-making lessons into useful, readable notes."},"publisher":{"@type":"Organization","name":"OutBrick","url":"https://www.outbrick.site","logo":{"@type":"ImageObject","url":"https://www.outbrick.site/icon.png"}},"articleSection":"Player habits","keywords":"puzzle games, well-being, motivation, casual gaming","citation":["https://doi.org/10.1037/a0019440","https://doi.org/10.1037/a0034857","https://doi.org/10.1177/0018720817715360","https://doi.org/10.1007/s43076-021-00062-6","https://doi.org/10.1098/rsos.220411"]}15:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1f"}}]
16:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"OutBrick\",\"item\":\"https://www.outbrick.site\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Journal\",\"item\":\"https://www.outbrick.site/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Why a two-minute puzzle can feel like a proper reset\",\"item\":\"https://www.outbrick.site/blog/why-two-minute-puzzles-feel-good\"}]}"}}]
17:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is OutBrick intended to improve mental health?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. OutBrick is a recreational puzzle. Research on casual play can inform design, but it does not make the game a treatment or guarantee a well-being outcome.\"}},{\"@type\":\"Question\",\"name\":\"Why are OutBrick sessions short?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Short sessions make the core puzzle legible and let play fit around real life. You can keep playing, but the game does not require a long uninterrupted block of time.\"}}]}"}}]
18:["$","div",null,{"className":"article-body","children":[["$","section","the-feeling-of-a-clean-clear",{"id":"the-feeling-of-a-clean-clear","children":[["$","h2",null,{"children":"The feeling of a clean clear"}],[["$","p","A satisfying puzzle does not need to overwhelm you with content. It needs to make the relationship between your choice and the result easy to feel. Slide a brick, read the opening, and watch the gate answer back. That little exchange is the emotional centre of OutBrick.",{"children":"A satisfying puzzle does not need to overwhelm you with content. It needs to make the relationship between your choice and the result easy to feel. Slide a brick, read the opening, and watch the gate answer back. That little exchange is the emotional centre of OutBrick."}],["$","p","The motivational model proposed by Przybylski, Rigby, and Ryan describes game engagement through three basic needs: competence, autonomy, and relatedness. A small puzzle can touch the first two immediately. You understand a rule, then prove something to yourself by using it. The pleasure comes from authorship as much as from winning.",{"children":"The motivational model proposed by Przybylski, Rigby, and Ryan describes game engagement through three basic needs: competence, autonomy, and relatedness. A small puzzle can touch the first two immediately. You understand a rule, then prove something to yourself by using it. The pleasure comes from authorship as much as from winning."}]],null,null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","motivation-2010",{"href":"#reference-motivation-2010","aria-label":"Jump to source: Przybylski, Rigby, & Ryan (2010)","children":["[",1,"]"]}]]]}]]}],["$","section","what-short-play-can-and-cannot-do",{"id":"what-short-play-can-and-cannot-do","children":[["$","h2",null,{"children":"What short play can—and cannot—do"}],[["$","p","A controlled study of casual game play found stronger short-term affective restoration and engagement after a cognitively demanding task, while the evidence for broad cognitive restoration was less certain. That distinction matters. A game can help you feel more ready to continue without turning into a magical brain upgrade.",{"children":"A controlled study of casual game play found stronger short-term affective restoration and engagement after a cognitively demanding task, while the evidence for broad cognitive restoration was less certain. That distinction matters. A game can help you feel more ready to continue without turning into a magical brain upgrade."}],["$","p","A separate study comparing a casual game with a body-scan mindfulness exercise found reductions in psychological and physiological stress in both groups. Mindfulness performed better on self-reported psychological stress, so the honest takeaway is not that games replace other practices. It is that a well-sized game can be one modest option in a larger day.",{"children":"A separate study comparing a casual game with a body-scan mindfulness exercise found reductions in psychological and physiological stress in both groups. Mindfulness performed better on self-reported psychological stress, so the honest takeaway is not that games replace other practices. It is that a well-sized game can be one modest option in a larger day."}]],null,null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],["$L20","$L21","$L22"]]}]]}],"$L23","$L24"]}]
19:["$","section",null,{"id":"faq","className":"article-faq","children":[["$","div",null,{"className":"blog-kicker","children":"Questions, answered"}],["$","h2",null,{"children":"A few useful answers"}],[["$","details","Is OutBrick intended to improve mental health?",{"children":[["$","summary",null,{"children":"Is OutBrick intended to improve mental health?"}],["$","p",null,{"children":"No. OutBrick is a recreational puzzle. Research on casual play can inform design, but it does not make the game a treatment or guarantee a well-being outcome."}]]}],["$","details","Why are OutBrick sessions short?",{"children":[["$","summary",null,{"children":"Why are OutBrick sessions short?"}],["$","p",null,{"children":"Short sessions make the core puzzle legible and let play fit around real life. You can keep playing, but the game does not require a long uninterrupted block of time."}]]}]]]}]
1a:["$","section",null,{"id":"references","className":"article-references","children":[["$","div",null,{"className":"blog-kicker","children":[["$","$L10",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","size":14}]," APA 7 reference trail"]}],["$","h2",null,{"children":"References"}],["$","p",null,{"className":"article-reference-intro","children":"The claims in this story are grounded in the sources below. External links open the source in a new tab; first-party histories and editorial explainers are labelled by context in the article."}],["$","ol",null,{"children":[["$","li","motivation-2010",{"id":"reference-motivation-2010","children":[["$","span",null,{"children":"Przybylski, A. K., Rigby, C. S., & Ryan, R. M. (2010). A motivational model of video game engagement. Review of General Psychology, 14(2), 154–166."}]," ",["$","a",null,{"href":"https://doi.org/10.1037/a0019440","target":"_blank","rel":"noreferrer","children":["Read source ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1a:props:children:0:props:children:0:props:iconNode","className":"lucide-external-link","size":13}]]}]]}],["$","li","benefits-2014",{"id":"reference-benefits-2014","children":[["$","span",null,{"children":"Granic, I., Lobel, A., & Engels, R. C. M. E. (2014). The benefits of playing video games. The American Psychologist, 69(1), 66–78."}]," ",["$","a",null,{"href":"https://doi.org/10.1037/a0034857","target":"_blank","rel":"noreferrer","children":["Read source ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1a:props:children:0:props:children:0:props:iconNode","className":"lucide-external-link","size":13}]]}]]}],["$","li","restoration-2017",{"id":"reference-restoration-2017","children":[["$","span",null,{"children":"Rupp, M. A., Sweetman, R., Sosa, A. E., Smither, J. A., & McConnell, D. S. (2017). Searching for affective and cognitive restoration: Examining the restorative effects of casual video game play. Human Factors, 59(7), 1096–1107."}]," ",["$","a",null,{"href":"https://doi.org/10.1177/0018720817715360","target":"_blank","rel":"noreferrer","children":["Read source ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1a:props:children:0:props:children:0:props:iconNode","className":"lucide-external-link","size":13}]]}]]}],["$","li","casual-stress-2021",{"id":"reference-casual-stress-2021","children":[["$","span",null,{"children":"Desai, V., Gupta, A., Andersen, L., Ronnestrand, B., & Wong, M. (2021). Stress-reducing effects of playing a casual video game among undergraduate students. Trends in Psychology, 29(3), 563–579."}]," ",["$","a",null,{"href":"https://doi.org/10.1007/s43076-021-00062-6","target":"_blank","rel":"noreferrer","children":["Read source ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1a:props:children:0:props:children:0:props:iconNode","className":"lucide-external-link","size":13}]]}]]}],["$","li","time-wellbeing-2022",{"id":"reference-time-wellbeing-2022","children":[["$","span",null,{"children":"Vuorre, M., Johannes, N., Magnusson, K., & Przybylski, A. K. (2022). Time spent playing video games is unlikely to impact well-being. Royal Society Open Science, 9(7), 220411."}]," ",["$","a",null,{"href":"https://doi.org/10.1098/rsos.220411","target":"_blank","rel":"noreferrer","children":["Read source ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1a:props:children:0:props:children:0:props:iconNode","className":"lucide-external-link","size":13}]]}]]}]]}]]}]
