dgets"}],["$","a",null,{"href":"/about","children":"About OutBrick"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"footer-label","children":"Read about"}],["$","a",null,{"href":"/blog#category-player-habits","children":"Player habits"}],["$","a",null,{"href":"/blog#category-success-stories","children":"Success stories"}],["$","a",null,{"href":"/blog#category-game-craft","children":"Game craft"}],["$","a",null,{"href":"/blog#category-inclusive-design","children":"Inclusive design"}],["$","a",null,{"href":"/research","children":"Research method"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"footer-label","children":"Contact"}],["$","a",null,{"href":"/support","children":"Support"}],["$","a",null,{"href":"/contact","children":["Contact OutBrick ",["$","$L10",null,{"ref":"$undefined","iconNode":"$12:props:children:0:props:children:1:props:children:4:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"href":"/accessibility","children":["Accessibility ",["$","$L10",null,{"ref":"$undefined","iconNode":"$12:props:children:0:props:children:1:props:children:4:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}]]}],["$","div",null,{"className":"footer-bottom","children":[["$","span",null,{"children":"© 2026 OutBrick"}],["$","span",null,{"children":"Research is cited. Claims stay modest."}],["$","span",null,{"children":"Made with bricks and patience."}]]}]]}]
23:T555,{"@context":"https://schema.org","@type":"BlogPosting","@id":"https://www.outbrick.site/blog/cozy-progress-without-grind/#article","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.outbrick.site/blog/cozy-progress-without-grind"},"headline":"From Stardew Valley to cozy play: designing for gentle progress","description":"A success story about patient craft, visible progress, and why a game can feel generous without becoming frictionless.","image":["https://www.outbrick.site/blog/cozy-progress-without-grind.png"],"datePublished":"2026-09-04","dateModified":"2026-09-04","author":{"@type":"Person","name":"OutBrick Editorial Desk","description":"The OutBrick Editorial Desk turns player research, accessibility practice, and game-making lessons into useful, readable notes."},"publisher":{"@type":"Organization","name":"OutBrick","url":"https://www.outbrick.site","logo":{"@type":"ImageObject","url":"https://www.outbrick.site/icon.png"}},"articleSection":"Success stories","keywords":"Stardew Valley, cozy games, progression, game design","citation":["https://www.stardewvalley.net/clarification-on-the-relationship-between-chucklefish-and-stardew-valley/","https://doi.org/10.1037/a0019440","https://doi.org/10.1098/rsos.241174","https://doi.org/10.1098/rsos.220411"]}15:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$23"}}]
16:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"OutBrick\",\"item\":\"https://www.outbrick.site\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Journal\",\"item\":\"https://www.outbrick.site/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"From Stardew Valley to cozy play: designing for gentle progress\",\"item\":\"https://www.outbrick.site/blog/cozy-progress-without-grind\"}]}"}}]
17:["$","h2",null,{"children":"The work behind the welcome"}]
18:["$","p","Stardew Valley often feels effortless to enter, but its welcome is the result of sustained craft. In a clarification about the game’s development, creator Eric Barone wrote that he was the only person to work on Stardew Valley during its four-and-a-half-year development, with the publisher contributing only to multiplayer networking. That is a first-person account, so it should be read as a creator statement rather than a complete production history, but it makes the scale of the solo experiment clear.",{"children":"Stardew Valley often feels effortless to enter, but its welcome is the result of sustained craft. In a clarification about the game’s development, creator Eric Barone wrote that he was the only person to work on Stardew Valley during its four-and-a-half-year development, with the publisher contributing only to multiplayer networking. That is a first-person account, so it should be read as a creator statement rather than a complete production history, but it makes the scale of the solo experiment clear."}]
19:["$","p","The lesson for a small studio is not “work alone.” It is that a warm player experience can be built from thousands of deliberate, legible decisions. A soft landing is still a technical and editorial achievement.",{"children":"The lesson for a small studio is not “work alone.” It is that a warm player experience can be built from thousands of deliberate, legible decisions. A soft landing is still a technical and editorial achievement."}]
1a:["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","stardew-solo-2018",{"href":"#reference-stardew-solo-2018","aria-label":"Jump to source: Barone (2018)","children":["[",1,"]"]}]]]}]
1b:["$","section","progress-you-can-feel",{"id":"progress-you-can-feel","children":[["$","h2",null,{"children":"Progress you can feel"}],[["$","p","Gentle progress has a visible shape. A seed becomes a plant, a room becomes yours, a path opens, or a familiar routine gains one new possibility. The player does not need a reward explosion to understand that their attention mattered.",{"children":"Gentle progress has a visible shape. A seed becomes a plant, a room becomes yours, a path opens, or a familiar routine gains one new possibility. The player does not need a reward explosion to understand that their attention mattered."}],["$","p","That clarity connects with the motivational model of competence and autonomy: players want to feel capable, and they want their actions to belong to them. The research does not say that every cozy system creates well-being. It gives designers a useful vocabulary for why authored progress can feel satisfying.",{"children":"That clarity connects with the motivational model of competence and autonomy: players want to feel capable, and they want their actions to belong to them. The research does not say that every cozy system creates well-being. It gives designers a useful vocabulary for why authored progress can feel satisfying."}]],null,null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","motivation-2010",{"href":"#reference-motivation-2010","aria-label":"Jump to source: Przybylski, Rigby, & Ryan (2010)","children":["[",2,"]"]}],["$","a","gaming-fit-2025",{"href":"#reference-gaming-fit-2025","aria-label":"Jump to source: Ballou et al. (2025)","children":["[",3,"]"]}]]]}]]}]
1c:["$","section","gentle-does-not-mean-empty",{"id":"gentle-does-not-mean-empty","children":[["$","h2",null,{"children":"Gentle does not mean empty"}],[["$","p","A game becomes flat when “cozy” means that nothing can surprise or resist the player. The better version keeps some friction: a season changes, a resource is finite, a neighbour has a schedule, or a puzzle asks you to look again. The friction is meaningful because the game gives you time and tools to respond.",{"children":"A game becomes flat when “cozy” means that nothing can surprise or resist the player. The better version keeps some friction: a season changes, a resource is finite, a neighbour has a schedule, or a puzzle asks you to look again. The friction is meaningful because the game gives you time and tools to respond."}],["$","p","For OutBrick, that means a board can be kind without being solved for you. The rules stay firm, the answer is earned, and undo keeps an experiment from becoming a punishment. The player gets a small problem with a clear edge, not a blank screen disguised as relaxation.",{"children":"For OutBrick, that means a board can be kind without being solved for you. The rules stay firm, the answer is earned, and undo keeps an experiment from becoming a punishment. The player gets a small problem with a clear edge, not a blank screen disguised as relaxation."}]],["$","ul",null,{"className":"article-bullets","children":[["$","li","Make progress visible without making it noisy",{"children":"Make progress visible without making it noisy"}],["$","li","Let a return session begin with recognition",{"children":"Let a return session begin with recognition"}],["$","li","Keep enough resistance for choices to matter",{"children":"Keep enough resistance for choices to matter"}],["$","li","Use recovery tools to protect curiosity",{"children":"Use recovery tools to protect curiosity"}]]}],null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","motivation-2010",{"href":"#reference-motivation-2010","aria-label":"Jump to source: Przybylski, Rigby, & Ryan (2010)","children":["[",2,"]"]}],["$","a","time-wellbeing-2022",{"href":"#reference-time-wellbeing-2022","aria-label":"Jump to source: Vuorre et al. (2022)","children":["[",4,"]"]}]]]}]]}]
1d:["$","section","a-welcoming-return",{"id":"a-welcoming-return","children":[["$","h2",null,{"children":"Build for the welcoming return"}],[["$","p","The strongest cozy games do not only design the first session. They design the feeling of opening the game after a busy week. A player can remember the world, see one inviting next step, and decide whether today is a two-minute visit or a longer stay.",{"children":"The strongest cozy games do not only design the first session. They design the feeling of opening the game after a busy week. A player can remember the world, see one inviting next step, and decide whether today is a two-minute visit or a longer stay."}],["$","p","That is the part OutBrick wants to make its own: a board that meets you where you are, a little progress that remains yours, and an experience that never confuses pressure with care.",{"children":"That is the part OutBrick wants to make its own: a board that meets you where you are, a little progress that remains yours, and an experience that never confuses pressure with care."}]],null,null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","gaming-fit-2025",{"href":"#reference-gaming-fit-2025","aria-label":"Jump to source: Ballou et al. (2025)","children":["[",3,"]"]}],["$","a","time-wellbeing-2022",{"href":"#reference-time-wellbeing-2022","aria-label":"Jump to source: Vuorre et al. (2022)","children":["[",4,"]"]}]]]}]]}]
