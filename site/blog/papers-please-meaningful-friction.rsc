1a:["$","div",null,{"className":"blog-card-body","children":[["$","div",null,{"className":"blog-card-meta","children":[["$","span",null,{"children":"Learning through play"}],["$","span",null,{"children":[["$","$L10",null,{"ref":"$undefined","iconNode":"$1:props:children:2:props:children:1:props:children:3:props:children:1:props:children:0:props:iconNode","className":"lucide-clock3 lucide-clock-3","size":13}]," ","8 min read"]}]]}],["$","h3",null,{"children":["$","a",null,{"href":"/blog/games-teach-curiosity-without-lecture","children":"When a game teaches curiosity without a lecture"}]}],["$","p",null,{"children":"How interactive systems can invite experimentation, and what MIT’s maker-learning work suggests about putting agency before explanation."}],["$","a",null,{"className":"blog-read-link","href":"/blog/games-teach-curiosity-without-lecture","children":["Read story ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-chevron-right","size":16}]]}]]}]
