1f:["$","div",null,{"className":"blog-card-body","children":[["$","div",null,{"className":"blog-card-meta","children":[["$","span",null,{"children":"Game craft"}],["$","span",null,{"children":[["$","$L10",null,{"ref":"$undefined","iconNode":"$1:props:children:2:props:children:1:props:children:3:props:children:1:props:children:0:props:iconNode","className":"lucide-clock3 lucide-clock-3","size":13}]," ","7 min read"]}]]}],["$","h3",null,{"children":["$","a",null,{"href":"/blog/kinder-difficulty-curve","children":"How to build a kinder difficulty curve"}]}],["$","p",null,{"children":"Challenge should stretch the player’s attention without making the relationship with the game feel brittle."}],["$","a",null,{"className":"blog-read-link","href":"/blog/kinder-difficulty-curve","children":["Read story ",["$","$L10",null,{"ref":"$undefined","iconNode":"$1:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-chevron-right","size":16}]]}]]}]
