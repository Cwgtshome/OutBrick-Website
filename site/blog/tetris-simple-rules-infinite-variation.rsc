17:["$","section","constraint-creates-meaning",{"id":"constraint-creates-meaning","children":[["$","h2",null,{"children":"Constraint creates meaning"}],[["$","p","A falling shape only becomes urgent because the board has limited space. The same piece can be a gift, a problem, or a setup depending on what is already there. Simple rules create variety when the player’s previous decisions change the meaning of the next one.",{"children":"A falling shape only becomes urgent because the board has limited space. The same piece can be a gift, a problem, or a setup depending on what is already there. Simple rules create variety when the player’s previous decisions change the meaning of the next one."}],["$","p","OutBrick’s sliding bricks work the same way. “Move the brick to its gate” is easy to say. The interesting part is that every move changes which lanes are open, which bricks are blocking one another, and which solution remains possible. The rule stays small while the situation keeps moving.",{"children":"OutBrick’s sliding bricks work the same way. “Move the brick to its gate” is easy to say. The interesting part is that every move changes which lanes are open, which bricks are blocking one another, and which solution remains possible. The rule stays small while the situation keeps moving."}]],null,null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","tetris-history",{"href":"#reference-tetris-history","aria-label":"Jump to source: The Tetris Company (n.d.)","children":["[",1,"]"]}],["$","a","flow-review-2019",{"href":"#reference-flow-review-2019","aria-label":"Jump to source: Ma et al. (2019)","children":["[",2,"]"]}]]]}]]}]
18:["$","section","rhythm-over-noise",{"id":"rhythm-over-noise","children":[["$","h2",null,{"children":"Rhythm over noise"}],[["$","p","The most memorable puzzle games often have a rhythm that players can internalize: see, predict, commit, resolve. Extra systems can be wonderful, but they should support that rhythm rather than interrupt it.",{"children":"The most memorable puzzle games often have a rhythm that players can internalize: see, predict, commit, resolve. Extra systems can be wonderful, but they should support that rhythm rather than interrupt it."}],["$","p","That is why OutBrick uses glossy feedback, haptics, and mascots as punctuation. The board does the thinking. The rest of the world helps the player feel the beat of a clear.",{"children":"That is why OutBrick uses glossy feedback, haptics, and mascots as punctuation. The board does the thinking. The rest of the world helps the player feel the beat of a clear."}]],["$","ul",null,{"className":"article-bullets","children":[["$","li","A rule you can explain in one breath",{"children":"A rule you can explain in one breath"}],["$","li","A state that changes after every decision",{"children":"A state that changes after every decision"}],["$","li","Feedback that confirms rather than decorates",{"children":"Feedback that confirms rather than decorates"}],["$","li","Variation that comes from context, not confusion",{"children":"Variation that comes from context, not confusion"}]]}],null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","motivation-2010",{"href":"#reference-motivation-2010","aria-label":"Jump to source: Przybylski, Rigby, & Ryan (2010)","children":["[",3,"]"]}],["$","a","tetris-history",{"href":"#reference-tetris-history","aria-label":"Jump to source: The Tetris Company (n.d.)","children":["[",1,"]"]}]]]}]]}]
19:["$","section","the-next-piece",{"id":"the-next-piece","children":[["$","h2",null,{"children":"The next piece"}],[["$","p","Tetris stays alive because the next piece always creates a new question. OutBrick’s version is quieter: the next board is another small question with a different shape, a different bottleneck, and another opportunity to notice more than you noticed last time.",{"children":"Tetris stays alive because the next piece always creates a new question. OutBrick’s version is quieter: the next board is another small question with a different shape, a different bottleneck, and another opportunity to notice more than you noticed last time."}],["$","p","Simple does not mean shallow. It means the player can see where the depth is coming from.",{"children":"Simple does not mean shallow. It means the player can see where the depth is coming from."}]],null,null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","tetris-history",{"href":"#reference-tetris-history","aria-label":"Jump to source: The Tetris Company (n.d.)","children":["[",1,"]"]}],["$","a","flow-review-2019",{"href":"#reference-flow-review-2019","aria-label":"Jump to source: Ma et al. (2019)","children":["[",2,"]"]}]]]}]]}]
