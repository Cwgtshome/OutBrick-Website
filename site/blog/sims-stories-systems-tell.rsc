dgets"}],["$","a",null,{"href":"/about","children":"About OutBrick"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"footer-label","children":"Read about"}],["$","a",null,{"href":"/blog#category-player-habits","children":"Player habits"}],["$","a",null,{"href":"/blog#category-success-stories","children":"Success stories"}],["$","a",null,{"href":"/blog#category-game-craft","children":"Game craft"}],["$","a",null,{"href":"/blog#category-inclusive-design","children":"Inclusive design"}],["$","a",null,{"href":"/research","children":"Research method"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"footer-label","children":"Contact"}],["$","a",null,{"href":"/support","children":"Support"}],["$","a",null,{"href":"/contact","children":["Contact OutBrick ",["$","$Lf",null,{"ref":"$undefined","iconNode":"$11:props:children:0:props:children:1:props:children:4:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"href":"/accessibility","children":["Accessibility ",["$","$Lf",null,{"ref":"$undefined","iconNode":"$11:props:children:0:props:children:1:props:children:4:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}]]}],["$","div",null,{"className":"footer-bottom","children":[["$","span",null,{"children":"© 2026 OutBrick"}],["$","span",null,{"children":"Research is cited. Claims stay modest."}],["$","span",null,{"children":"Made with bricks and patience."}]]}]]}]
20:T52e,{"@context":"https://schema.org","@type":"BlogPosting","@id":"https://www.outbrick.site/blog/sims-stories-systems-tell/#article","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.outbrick.site/blog/sims-stories-systems-tell"},"headline":"The Sims and the stories systems tell","description":"A long-running success story about player authorship, playful resistance, and the value of a game that does not write every line for you.","image":["https://www.outbrick.site/blog/sims-stories-systems-tell.png"],"datePublished":"2026-09-04","dateModified":"2026-09-04","author":{"@type":"Person","name":"Mourad Hamdi","description":"Mourad makes small, thoughtful games for the space between one task and the next. OutBrick is his ongoing experiment in calmer play."},"publisher":{"@type":"Organization","name":"OutBrick","url":"https://www.outbrick.site","logo":{"@type":"ImageObject","url":"https://www.outbrick.site/icon.png"}},"articleSection":"Success stories","keywords":"The Sims, emergent stories, systems design, player agency","citation":["https://news.xbox.com/en-us/2025/02/07/the-sims-at-25/?ver=3.7.1","https://doi.org/10.1037/a0019440","https://pmc.ncbi.nlm.nih.gov/articles/PMC6453078/","https://doi.org/10.1098/rsos.241174"]}14:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$20"}}]
15:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"OutBrick\",\"item\":\"https://www.outbrick.site\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Journal\",\"item\":\"https://www.outbrick.site/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"The Sims and the stories systems tell\",\"item\":\"https://www.outbrick.site/blog/sims-stories-systems-tell\"}]}"}}]
16:["$","h2",null,{"children":"The player is the author"}]
17:["$","p","In a 25-year retrospective, Xbox Wire describes the core idea of The Sims as the player’s story, with the game providing humorous pushback. It is a first-party-adjacent editorial account, so it is not an independent evaluation of the series, but it captures the design promise that made the franchise legible to generations of players: the system supplies the situation, and the player supplies the meaning.",{"children":"In a 25-year retrospective, Xbox Wire describes the core idea of The Sims as the player’s story, with the game providing humorous pushback. It is a first-party-adjacent editorial account, so it is not an independent evaluation of the series, but it captures the design promise that made the franchise legible to generations of players: the system supplies the situation, and the player supplies the meaning."}]
18:["$","p","This is different from giving players a giant sandbox and hoping something happens. Authorship needs materials that are understandable. A player should know what a choice might change, even if the final story surprises them.",{"children":"This is different from giving players a giant sandbox and hoping something happens. Authorship needs materials that are understandable. A player should know what a choice might change, even if the final story surprises them."}]
19:["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","sims-25-2025",{"href":"#reference-sims-25-2025","aria-label":"Jump to source: Gibson (2025)","children":["[",1,"]"]}]]]}]
1a:["$","section","pushback-makes-a-story",{"id":"pushback-makes-a-story","children":[["$","h2",null,{"children":"Pushback makes a story"}],[["$","p","A frictionless system produces a checklist. A hostile system produces fatigue. Playful pushback sits between them: the plan can go sideways, but the consequence is readable enough to become part of the memory.",{"children":"A frictionless system produces a checklist. A hostile system produces fatigue. Playful pushback sits between them: the plan can go sideways, but the consequence is readable enough to become part of the memory."}],["$","p","The motivational literature helps explain why this matters. Autonomy is not the absence of rules; it is the feeling that your decisions are yours inside a world that responds. Relatedness can come from characters, from other players, or from the imagined audience we tell the story to later.",{"children":"The motivational literature helps explain why this matters. Autonomy is not the absence of rules; it is the feeling that your decisions are yours inside a world that responds. Relatedness can come from characters, from other players, or from the imagined audience we tell the story to later."}]],null,null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","sims-25-2025",{"href":"#reference-sims-25-2025","aria-label":"Jump to source: Gibson (2025)","children":["[",1,"]"]}],["$","a","motivation-2010",{"href":"#reference-motivation-2010","aria-label":"Jump to source: Przybylski, Rigby, & Ryan (2010)","children":["[",2,"]"]}]]]}]]}]
1b:["$","section","small-systems-can-still-emerge",{"id":"small-systems-can-still-emerge","children":[["$","h2",null,{"children":"Small systems can still emerge"}],[["$","p","OutBrick does not simulate a neighbourhood. Its small system is the board: a brick occupies a lane, a gate waits for a matching shape, and one move changes what is possible next. The story is a sentence rather than a novel—“I saw the opening, committed to the long route, and had to undo two moves later.”",{"children":"OutBrick does not simulate a neighbourhood. Its small system is the board: a brick occupies a lane, a gate waits for a matching shape, and one move changes what is possible next. The story is a sentence rather than a novel—“I saw the opening, committed to the long route, and had to undo two moves later.”"}],["$","p","That sentence is enough to create ownership. The board is not merely presenting an answer; it is giving the player a sequence of decisions they can remember as theirs.",{"children":"That sentence is enough to create ownership. The board is not merely presenting an answer; it is giving the player a sequence of decisions they can remember as theirs."}]],["$","ul",null,{"className":"article-bullets","children":[["$","li","Give the player a small vocabulary of actions",{"children":"Give the player a small vocabulary of actions"}],["$","li","Let consequences remain readable",{"children":"Let consequences remain readable"}],["$","li","Allow a surprising outcome without hiding the rule",{"children":"Allow a surprising outcome without hiding the rule"}],["$","li","Make the final clear feel authored",{"children":"Make the final clear feel authored"}]]}],null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","motivation-2010",{"href":"#reference-motivation-2010","aria-label":"Jump to source: Przybylski, Rigby, & Ryan (2010)","children":["[",2,"]"]}],["$","a","flow-review-2019",{"href":"#reference-flow-review-2019","aria-label":"Jump to source: Ma et al. (2019)","children":["[",3,"]"]}]]]}]]}]
1c:["$","section","design-for-the-story-after",{"id":"design-for-the-story-after","children":[["$","h2",null,{"children":"Design for the story after"}],[["$","p","A successful system is often measured by what players say after the session. “I built a strange house,” “my neighbour became my rival,” or “I found the only lane that worked” are signs that the player is interpreting the design rather than merely consuming it.",{"children":"A successful system is often measured by what players say after the session. “I built a strange house,” “my neighbour became my rival,” or “I found the only lane that worked” are signs that the player is interpreting the design rather than merely consuming it."}],["$","p","OutBrick aims for that small afterimage. The next board should be new, but the player should leave with a clear moment they can carry into the next conversation, commute, or quiet pause.",{"children":"OutBrick aims for that small afterimage. The next board should be new, but the player should leave with a clear moment they can carry into the next conversation, commute, or quiet pause."}]],null,null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","sims-25-2025",{"href":"#reference-sims-25-2025","aria-label":"Jump to source: Gibson (2025)","children":["[",1,"]"]}],["$","a","gaming-fit-2025",{"href":"#reference-gaming-fit-2025","aria-label":"Jump to source: Ballou et al. (2025)","children":["[",4,"]"]}]]]}]]}]
