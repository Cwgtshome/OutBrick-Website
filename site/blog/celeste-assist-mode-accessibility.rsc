21:["$","section","more-than-one-signal",{"id":"more-than-one-signal","children":[["$","h2",null,{"children":"More than one signal"}],[["$","p","The W3C advises that color should not be the only visual means of conveying information. Microsoft’s game accessibility guidance makes a related case for pairing signals and considering play without sound, on a monochrome display, or after a long break.",{"children":"The W3C advises that color should not be the only visual means of conveying information. Microsoft’s game accessibility guidance makes a related case for pairing signals and considering play without sound, on a monochrome display, or after a long break."}],["$","p","In OutBrick, shapes, studs, spacing, contrast, and motion reinforce the color language. The result is better for players who cannot use hue reliably, but it is also better for everyone when the board explains itself at a glance.",{"children":"In OutBrick, shapes, studs, spacing, contrast, and motion reinforce the color language. The result is better for players who cannot use hue reliably, but it is also better for everyone when the board explains itself at a glance."}]],null,null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","w3c-color",{"href":"#reference-w3c-color","aria-label":"Jump to source: W3C Web Accessibility Initiative (n.d.)","children":["[",2,"]"]}],["$","a","microsoft-game-accessibility",{"href":"#reference-microsoft-game-accessibility","aria-label":"Jump to source: Microsoft (n.d.)","children":["[",3,"]"]}]]]}]]}]
22:["$","section","support-is-a-design-material",{"id":"support-is-a-design-material","children":[["$","h2",null,{"children":"Support is a design material"}],[["$","p","The most useful accessibility options are discoverable, reversible, and free of shame. They sit near the decision they affect, explain what they change, and allow the player to tune the experience as their context changes.",{"children":"The most useful accessibility options are discoverable, reversible, and free of shame. They sit near the decision they affect, explain what they change, and allow the player to tune the experience as their context changes."}],["$","p","That is the standard OutBrick is aiming for. A kinder difficulty curve, a clear recovery path, and a color-blind mode are not decorations around the puzzle. They help the puzzle remain the puzzle for more people.",{"children":"That is the standard OutBrick is aiming for. A kinder difficulty curve, a clear recovery path, and a color-blind mode are not decorations around the puzzle. They help the puzzle remain the puzzle for more people."}]],["$","ul",null,{"className":"article-bullets","children":[["$","li","Pair color with shape and pattern",{"children":"Pair color with shape and pattern"}],["$","li","Keep support options reversible and visible",{"children":"Keep support options reversible and visible"}],["$","li","Test with players who use the options",{"children":"Test with players who use the options"}],["$","li","Treat unconventional play as valid play",{"children":"Treat unconventional play as valid play"}]]}],null,["$","p",null,{"className":"article-source-note","children":[["$","span",null,{"children":"Research trail"}],[["$","a","accessibility-hard-mode-2024",{"href":"#reference-accessibility-hard-mode-2024","aria-label":"Jump to source: Martinez, Froehlich, & Fogarty (2024)","children":["[",1,"]"]}],["$","a","w3c-color",{"href":"#reference-w3c-color","aria-label":"Jump to source: W3C Web Accessibility Initiative (n.d.)","children":["[",2,"]"]}]]]}]]}]
