15:T5e7,{"@context":"https://schema.org","@type":"CollectionPage","@id":"https://www.outbrick.site/mascots#page","url":"https://www.outbrick.site/mascots","name":"Meet the OutBrick mascots","description":"Meet Bloo, Peach, and Sprout—the friendly OutBrick mascots who make every clear feel like a little story.","isPartOf":{"@type":"WebSite","name":"OutBrick","url":"https://www.outbrick.site"},"mainEntity":{"@type":"ItemList","itemListElement":[{"@type":"ListItem","position":1,"url":"https://www.outbrick.site/mascots/bloo","name":"Bloo","image":"https://www.outbrick.site/assets/bloo-cheer.png","description":"Bloo is the first to wave, the first to volunteer, and—occasionally—the first to slide the wrong brick with tremendous confidence."},{"@type":"ListItem","position":2,"url":"https://www.outbrick.site/mascots/peach","name":"Peach","image":"https://www.outbrick.site/assets/peach-think.png","description":"Peach notices the corner nobody else saw, counts the moves twice, and keeps a spare deep breath tucked behind her smile."},{"@type":"ListItem","position":3,"url":"https://www.outbrick.site/mascots/sprout","name":"Sprout","image":"https://www.outbrick.site/assets/sprout-cheer.png","description":"Sprout spots the odd gap, asks why the gate is there, and finds the long way around before anyone has finished saying “please be careful.”"}]}}14:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$15"}}]
