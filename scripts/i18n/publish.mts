// Decides which catalog languages are published: those whose site and email catalogs cover every
// English string. Writes lib/i18n/catalog/published.json (read by lib/i18n/locales.ts) and the
// browser catalogs public/i18n/<locale>.js. Runs in prebuild; `--check` fails if the committed
// list is out of date.
//   node --experimental-strip-types --no-warnings scripts/i18n/publish.mts
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import { catalogAreas, clientAreas, workerAreas } from '../../lib/i18n/catalog-areas.ts';

const root = path.resolve(import.meta.dirname, '../..');
const dir = path.join(root, 'lib/i18n/catalog');
// The Help Centre's guides are published guide by guide (an untranslated guide shows the English
// and is not indexed in that language), so they do not hold a language back.
const required = catalogAreas.filter((area) => !area.startsWith('help-') || area === 'help-ui');
const catalogLocales = ['it', 'ko', 'nl', 'ru', 'tr', 'zh-Hans', 'ar', 'ca', 'cs', 'da', 'fi', 'hr', 'hu', 'id', 'ms', 'nb', 'pl', 'ro', 'sk', 'sv', 'th', 'vi', 'zh-Hant', 'es-419', 'he', 'pt-PT', 'el', 'uk', 'fr-CA', 'hi', 'sl', 'ur', 'bn'];
const read = (file: string): Record<string, string> => (fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, 'utf8')) : {});

// --force it,ko publishes languages whatever their coverage (local previews); --trace makes the
// prerender log every English string a catalog language had to fall back on (scripts/i18n/trace.mjs).
const arg = (name: string) => { const i = process.argv.indexOf(name); return i > 0 ? process.argv[i + 1] : undefined; };
const forced = new Set((arg('--force') ?? '').split(',').filter(Boolean));
const trace = process.argv.includes('--trace');
const published: string[] = [];
const lines: string[] = [];
for (const locale of catalogLocales) {
  let missing = 0, total = 0;
  for (const area of required) {
    const english = read(path.join(dir, 'en', `${area}.json`));
    const translated = read(path.join(dir, locale, `${area}.json`));
    for (const key of Object.keys(english)) { total++; if (typeof translated[key] !== 'string' || !translated[key].trim()) missing++; }
  }
  const ok = (missing === 0 && total > 0) || forced.has(locale);
  if (ok) published.push(locale);
  lines.push(`${locale}: ${ok ? 'published' : `${missing} of ${total} strings missing`}`);
}
const file = path.join(dir, 'published.json');
const body = `${JSON.stringify(published)}\n`;
if (process.argv.includes('--check')) {
  if (!fs.existsSync(file) || fs.readFileSync(file, 'utf8') !== body) { console.error('lib/i18n/catalog/published.json is out of date'); process.exitCode = 1; }
} else fs.writeFileSync(file, body);

// The browser's share of each published language: the areas client components translate with.
const out = path.join(root, 'public/i18n');
fs.rmSync(out, { recursive: true, force: true });
fs.mkdirSync(out, { recursive: true });
const manifest: Record<string, string> = {};
for (const locale of published) {
  const words: Record<string, string> = {};
  for (const area of clientAreas) Object.assign(words, read(path.join(dir, locale, `${area}.json`)));
  const js = `(globalThis.__OB_I18N??={})[${JSON.stringify(locale)}]=Object.assign(globalThis.__OB_I18N[${JSON.stringify(locale)}]||{},${JSON.stringify(words)});\n`;
  const hash = crypto.createHash('sha256').update(js).digest('hex').slice(0, 10);
  fs.writeFileSync(path.join(out, `${locale}.${hash}.js`), js);
  manifest[locale] = `/i18n/${locale}.${hash}.js`;
}
fs.writeFileSync(path.join(dir, 'client-scripts.json'), `${JSON.stringify(manifest, null, 1)}\n`);

// Static imports of the server's catalogs: every area for prerendering, the Worker's areas for the
// Worker (emails, community pages) and Node tests. Generated so bundlers see plain JSON imports.
function installer(name: string, areas: readonly string[], note: string) {
  const imports: string[] = [];
  const calls: string[] = [];
  for (const locale of published) for (const area of areas) {
    if (!fs.existsSync(path.join(dir, locale, `${area}.json`))) continue;
    const id = `c_${locale.replace(/-/g, '_')}_${area.replace(/-/g, '_')}`;
    imports.push(`import ${id} from './${locale}/${area}.json' with { type: 'json' };`);
    calls.push(`installCatalog('${locale}', ${id});`);
  }
  const traceLine = trace && name === 'install-all.ts' ? "(globalThis as { __OB_I18N_TRACE?: Set<string> }).__OB_I18N_TRACE = new Set();\n" : '';
  fs.writeFileSync(path.join(dir, name), `// Generated by scripts/i18n/publish.mts. ${note}\nimport { installCatalog } from '../catalog.ts';\n${imports.join('\n')}\n\n${traceLine}${calls.join('\n')}\nexport {};\n`);
}
installer('install-all.ts', catalogAreas, 'Every catalog, for prerendering (imported by app/site-document.tsx).');
installer('install-worker.ts', workerAreas, 'The Worker\'s catalogs: emails and community pages (imported by emails/i18n.ts).');
console.log(lines.join('\n'));
